#!/bin/sh

now=$(date '+%H:%M')
if [ "$now" = "00:00" ]; then
  pkill -RTMIN+2 -u "$(id -u)" i3blocks
fi

icon=
case "$now" in
  00:[012]?|12:[012]?) icon="🕛";;
  00:[345]?|12:[345]?) icon="🕧";;
  01:[012]?|13:[012]?) icon="🕐";;
  01:[345]?|13:[345]?) icon="🕜";;
  02:[012]?|14:[012]?) icon="🕑";;
  02:[345]?|14:[345]?) icon="🕝";;
  03:[012]?|15:[012]?) icon="🕒";;
  03:[345]?|15:[345]?) icon="🕞";;
  04:[012]?|16:[012]?) icon="🕓";;
  04:[345]?|16:[345]?) icon="🕟";;
  05:[012]?|17:[012]?) icon="🕔";;
  05:[345]?|17:[345]?) icon="🕠";;
  06:[012]?|18:[012]?) icon="🕕";;
  06:[345]?|18:[345]?) icon="🕡";;
  07:[012]?|19:[012]?) icon="🕖";;
  07:[345]?|19:[345]?) icon="🕢";;
  08:[012]?|20:[012]?) icon="🕗";;
  08:[345]?|20:[345]?) icon="🕣";;
  09:[012]?|21:[012]?) icon="🕘";;
  09:[345]?|21:[345]?) icon="🕤";;
  10:[012]?|22:[012]?) icon="🕙";;
  10:[345]?|22:[345]?) icon="🕥";;
  11:[012]?|23:[012]?) icon="🕚";;
  11:[345]?|23:[345]?) icon="🕦";;
esac

printf "%s %s\n" "$icon" "$now"
