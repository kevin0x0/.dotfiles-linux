#!/bin/sh

RUNTIME_STATE_DIR=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
daemonpidfile=$RUNTIME_STATE_DIR/proxy-daemon-pid

msg() {
  [ "$3" = 2 ] && level=-e || level=-m
  notify-or-print "$level" -n proxy-start -- "$1" "$2"
}

instance_exists() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "A proxy instance is already running")
  msg "$summary" "$body" "2"
}

clash_not_found() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Clash not found")
  msg "$summary" "$body" "2"
}

proxy_stopped() {
  summary=$(i18n -n proxy "Success")
  body=$(i18n -n proxy "Proxy stopped")
  msg "$summary" "$body" "1"
}

proxy_started() {
  summary=$(i18n -n proxy "Success")
  body=$(i18n -n proxy "Proxy is started")
  msg "$summary" "$body" "1"
}

proxy_not_started() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Proxy not started")
  msg "$summary" "$body" "2"
}

proxy_not_stopped() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Proxy not stopped")
  msg "$summary" "$body" "2"
}

proxy_crashed() {
  summary=$(i18n -n proxy "Error")
  body=$(i18n -n proxy "Proxy exited abnormally")
  msg "$summary" "$body" "2"
}

proxy_exited_normally() {
  summary=$(i18n -n proxy "Unexpected behaviour")
  body=$(i18n -n proxy "Proxy exited normally")
  msg "$summary" "$body" "2"
}

stop_proxy() {
  sudo $opt_askpass -- sh -c 'kill -s 0 "$1" && kill "$1"' --  "$proxypid"
}

opt_askpass=
while getopts "p" opts; do
  case $opts in
    p)
      opt_askpass=--askpass
      ;;
    '?')
      exit 2
      ;;
  esac
done

lock proxy-main
trylock proxy-daemon || { instance_exists; unlock proxy-main; exit 1; }

# This must be put before the sudo comamnd to create state directory as current user.
notify-state -c proxy-started proxy-stopped proxy-crashed proxy-stop

CLASH_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}/clash
CLASH_BIN=$(command -v clash) || { clash_not_found; unlock proxy-daemon proxy-main; exit 1; }

trap ':' USR2

sudo --preserve-env=XDG_RUNTIME_DIR,PATH $opt_askpass -- "$(command -v proxy-wrapper)" \
  "$$" "$CLASH_BIN" -d "$CLASH_CONFIG_HOME" &
proxypid=$!

while sleep 5; do
  kill -s USR2 "$$"
done &
timerpid=$!

[ -e "$daemonpidfile" ] && rm -- "$daemonpidfile"
printf "%d\n" "$$" >"$daemonpidfile"

unlock proxy-main

state=starting
while :; do
  # Assume that proxy never exits with exitcode greater than 128
  wait "$proxypid"
  exitcode=$?

  case "$state" in
    starting)
      if [ "$exitcode" -ne 0 ] && [ "$exitcode" -le 128 ]; then
        proxy_crashed
        state=crashed
      elif notify-state -tc proxy-started; then
        proxy_started
        state=running
      elif notify-state -tc proxy-stopped; then
        proxy_exited_normally
        state=stopped
      elif notify-state -tc proxy-crashed; then
        proxy_not_started
        state=stopped
      fi
      ;;
    running)
      if [ "$exitcode" -ne 0 ] && [ "$exitcode" -le 128 ]; then
        proxy_crashed
        state=crashed
      elif notify-state -tc proxy-stopped; then
        proxy_exited_normally
        state=stopped
      elif notify-state -tc proxy-crashed; then
        proxy_crashed
        state=crashed
      elif notify-state -tc proxy-stop && [ "$exitcode" -gt 128 ]; then
        stop_proxy && state=stopping || proxy_not_stopped
      fi
      ;;
    stopping)
      if [ "$exitcode" -ne 0 ] && [ "$exitcode" -le 128 ]; then
        proxy_crashed
        state=crashed
      elif notify-state -tc proxy-stopped; then
        proxy_stopped
        state=stopped
      elif notify-state -tc proxy-crashed; then
        proxy_crashed
        state=crashed
      fi
      ;;
    stopped|crashed)
      notify-state -c proxy-started proxy-stopped proxy-crashed proxy-stop
      break
      ;;
  esac
done

kill "$timerpid"
while ! wait; do
  :
done

lock proxy-main
rm -- "$daemonpidfile"
unlock proxy-daemon proxy-main
