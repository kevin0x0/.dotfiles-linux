#!/bin/sh

RUNTIME_STATE_DIR=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
daemonpidfile="$RUNTIME_STATE_DIR/proxy-daemon-pid"
notify_start="$RUNTIME_STATE_DIR/proxy-started"
notify_stop="$RUNTIME_STATE_DIR/proxy-stop"
notify_timer_exited="$RUNTIME_STATE_DIR/proxy-timer-exited"

msg() {
  [ "$3" = 2 ] && level=-e || level=-m
  notify-or-print "$level" -n proxy-start -- "$1" "$2"
}

instance_exists() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "A proxy instance is already running")
  msg "$summary" "$body" "2"
}

clash_not_found() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Clash not found")
  msg "$summary" "$body" "2"
}

proxy_stopped() {
  summary=$(i18n -n proxy "Success")
  body=$(i18n -n proxy "Proxy stopped")
  msg "$summary" "$body" "1"
}

proxy_started() {
  summary=$(i18n -n proxy "Success")
  body=$(i18n -n proxy "Proxy is started")
  msg "$summary" "$body" "1"
}

proxy_not_started() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Proxy not started")
  msg "$summary" "$body" "2"
}

proxy_not_stopped() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "Proxy not stopped")
  msg "$summary" "$body" "2"
}

proxy_crashed() {
  summary=$(i18n -n proxy "Error")
  body=$(i18n -n proxy "Proxy exited abnormally")
  msg "$summary" "$body" "2"
}

proxy_exited_normally() {
  summary=$(i18n -n proxy "Unexpected behaviour")
  body=$(i18n -n proxy "Proxy exited normally")
  msg "$summary" "$body" "2"
}

stop_proxy() {
  sudo $opt_askpass -- sh -c 'kill -s 0 "$1" && kill "$1"' --  "$pid"
}

opt_askpass=
while getopts "p" opts; do
  case $opts in
    p)
      opt_askpass=--askpass
      ;;
    '?')
      exit 2
      ;;
  esac
done

lock proxy-main
trylock proxy-daemon || { instance_exists; unlock proxy-main; exit 1; }

CLASH_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}/clash
CLASH_BIN=$(command -v clash) || { clash_not_found; unlock proxy-daemon proxy-main; exit 1; }

[ -e "$notify_start" ] && rm -f -- "$notify_start"
[ -e "$notify_stop" ] && rm -f -- "$notify_stop"

trap ':' USR2
trap ': >"$notify_stop"' USR1 INT TERM

sudo $opt_askpass -- sh -c ': >"$1"; kill -s USR2 "$2"; shift 2; exec "$@"' -- \
  "$notify_start" "$$" "$CLASH_BIN" -d "$CLASH_CONFIG_HOME" &
pid=$!

[ -e "$daemonpidfile" ] && rm -- "$daemonpidfile"
printf "%d\n" "$$" >"$daemonpidfile"

# wake up every 5 seconds to check whether there is any state changed.
(trap ': >"$notify_timer_exited"; exit 0' TERM; trap '' HUP; while sleep 5; do kill -s USR2 "$$"; done)&
timerpid=$!

unlock proxy-main

state=starting
while :; do
  wait "$pid"
  exitcode=$?

  case "$state" in
    starting)
      if [ "$exitcode" -gt 128 ]; then
        if [ -e "$notify_start" ]; then
          proxy_started
          state=running
        fi
      elif [ "$exitcode" -ne 0 ]; then
        proxy_not_started
        state=stopped
      else
        proxy_exited_normally
        state=stopped
      fi
      ;;
    running)
      if [ "$exitcode" -gt 128 ]; then
        [ -e "$notify_stop" ] || continue
        if stop_proxy; then
          state=stopping
        else
          proxy_not_stopped
          rm -- "$notify_stop"
        fi
      elif [ "$exitcode" -ne 0 ]; then
        proxy_crashed
        state=crashed
      else
        proxy_exited_normally
        state=stopped
      fi
      ;;
    stopping)
      if [ "$exitcode" -gt 128 ]; then
        continue
      elif [ "$exitcode" -ne 0 ]; then
        proxy_crashed
        state=crashed
      else
        proxy_stopped
        state=stopped
      fi
      ;;
    stopped|crashed)
      [ -e "$notify_start" ] && rm -f -- "$notify_start"
      [ -e "$notify_stop" ] && rm -f -- "$notify_stop"
      break
      ;;
  esac
done

kill "$timerpid"
while [ ! -e "$notify_timer_exited" ]; do
  wait "$timerpid"
done

rm -- "$notify_timer_exited"

lock proxy-main
rm -- "$daemonpidfile"
unlock proxy-daemon proxy-main
