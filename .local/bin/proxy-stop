#!/bin/sh

daemonpidfile="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/proxy-daemon-pid"

msg() {
  [ "$3" = 2 ] && level=-e || level=-m
  notify-or-print "$level" -n proxy-stop -- "$1" "$2"
}

instance_not_exists() {
  summary=$(i18n -n proxy "Failure")
  body=$(i18n -n proxy "No running proxy instance")
  msg "$summary" "$body" "2"
}

lock proxy-main

[ -f "$daemonpidfile" ] || { instance_not_exists; unlock proxy-main; exit 1; }

notify-state 'proxy-stop'
kill -s USR2 "$(cat -- "$daemonpidfile")"

unlock proxy-main
