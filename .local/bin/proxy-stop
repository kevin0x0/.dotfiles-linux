#!/bin/sh

daemonpidfile="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/proxy-daemon-pid"

msg() {
  [ "$3" = 2 ] && level=-e || level=-m
  notify-or-print "$level" -n proxy-stop -- "$1" "$2"
}

instance_not_exists() {
  summary=Failure
  body="No running proxy instance"
  case ${LC_ALL:-$LANG} in
    zh_CN.UTF-8)
      summary="失败"
      body="没有正在运行的代理实例"
      ;;
  esac
  msg "$summary" "$body" "2"
}

lock proxy-main

[ -f "$daemonpidfile" ] || { instance_not_exists; unlock proxy-main; exit 1; }

kill -s USR1 "$(cat -- "$daemonpidfile")"

unlock proxy-main
