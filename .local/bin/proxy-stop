#!/bin/sh

daemonpidfile="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/proxy-daemon-pid"

msg() {
  summary=$1
  body=$2
  if command -v notify-send >/dev/null 2>&1 && [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
    [ "$3" = 2 ] && urgency=critical || urgency=normal
    notify-send --app-name proxy-stop --urgency "$urgency" -- "$summary" "$body"
  else
    printf "%s: %s\n" "$summary" "$body" >&"${3:-1}"
  fi
}

instance_not_exists() {
  summary=Failure
  body="No running proxy instance"
  case ${LC_ALL:-$LANG} in
    zh_CN.UTF-8)
      summary="失败"
      body="没有正在运行的代理实例"
      ;;
  esac
  msg "$summary" "$body" "2"
}

lock proxy-main

[ -f "$daemonpidfile" ] || { instance_not_exists; unlock proxy-main; exit 1; }

kill -USR1 "$(cat -- "$daemonpidfile")"

unlock proxy-main
