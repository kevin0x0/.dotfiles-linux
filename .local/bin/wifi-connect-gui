#!/bin/sh

wifi-connect-core menu-wrapper dmenu -v

exitcode=$?

summary=$(i18n -n wifi-connect "Failure")

case "$exitcode" in
  64)
    notify-or-print -en wifi-connect -- \
      "$summary" \
      "$(i18n -n wifi-connect "No wireless interface")"
    exit 64
    ;;
  65)
    notify-or-print -en wifi-connect -- \
      "$summary" \
      "$(i18n -n wifi-connect "Unable to create config file")"
    exit 65
    ;;
esac
